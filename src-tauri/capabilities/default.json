{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the application windows",
  "windows": ["main", "settings", "shortcut-guide"],
  "permissions": [
    "core:default",
    "core:window:allow-close",
    "core:window:allow-set-focus",
    "clipboard-manager:allow-read-text",
    "clipboard-manager:allow-write-text",
    "dialog:allow-open",
    "dialog:allow-save",
    "opener:default",
    {
      "identifier": "opener:allow-open-path",
      "allow": [{ "path": "$APPCACHE/external-edits/**" }]
    }
  ]
}
