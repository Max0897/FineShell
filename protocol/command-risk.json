{
  "comment": "AI 终端命令风险规则，前端（src/ai-command-risk.ts）与后端（src-tauri/src/agent_command_risk.rs）共用。正则均为不区分大小写，在整条命令上搜索。修改规则后同步更新 command-risk-cases.json。",
  "destructivePatterns": [
    "(^|[^\\w-])(rm|rmdir|unlink|shred|dd|wipefs|mkfs(\\.[\\w-]+)?|fdisk|sfdisk|parted|truncate|shutdown|reboot|poweroff|halt|kill|killall|pkill)([^\\w-]|$)",
    "--no-preserve-root",
    "\\bfind\\b[^|;&]*\\s-delete\\b",
    "\\bcrontab\\b[^|;&]*\\s-r\\b",
    "\\b(iptables|ip6tables)\\b[^|;&]*\\s(-F|--flush)\\b",
    "\\bnft\\b[^|;&]*\\bflush\\b",
    "\\bprune\\b",
    "\\bgit\\b[^|;&]*\\b(clean\\s+-\\w*f|reset\\s+--hard)",
    ">\\s*/dev/(sd|hd|vd|xvd|nvme|mmcblk)",
    ":\\(\\)\\s*\\{\\s*:\\s*\\|\\s*:\\s*&\\s*\\}\\s*;\\s*:"
  ],
  "unsafeCharacters": ";&<>`$(){}\\!\n\r",
  "readOnlyCommands": {
    "cat": {},
    "date": {},
    "df": {},
    "dig": {},
    "dirname": {},
    "basename": {},
    "du": {},
    "echo": {},
    "file": {},
    "findmnt": {},
    "free": {},
    "getent": {},
    "grep": {},
    "egrep": {},
    "fgrep": {},
    "head": {},
    "host": {},
    "hostname": { "maxArguments": 0 },
    "id": {},
    "last": {},
    "ls": {},
    "lsblk": {},
    "lscpu": {},
    "lsof": {},
    "md5sum": {},
    "nproc": {},
    "nslookup": {},
    "printenv": {},
    "ps": {},
    "pwd": {},
    "readlink": {},
    "realpath": {},
    "sha256sum": {},
    "sort": { "forbiddenArguments": ["-o", "--output"] },
    "ss": {},
    "netstat": {},
    "stat": {},
    "tail": {},
    "tree": {},
    "uniq": {},
    "cut": {},
    "wc": {},
    "uname": {},
    "uptime": {},
    "vmstat": {},
    "iostat": {},
    "w": {},
    "who": {},
    "whoami": {},
    "which": {},
    "whereis": {},
    "dmesg": { "forbiddenArguments": ["-c", "-C", "--clear", "--read-clear", "-n", "--console-level", "-D", "--console-off", "-E", "--console-on"] },
    "find": { "forbiddenArguments": ["-delete", "-exec", "-execdir", "-ok", "-okdir", "-fprint", "-fprint0", "-fprintf", "-fls"] },
    "journalctl": { "forbiddenArguments": ["--vacuum-size", "--vacuum-time", "--vacuum-files", "--rotate", "--flush", "--sync", "--relinquish-var", "--smart-relinquish-var", "--setup-keys", "--update-catalog"] },
    "systemctl": { "subcommands": ["status", "is-active", "is-enabled", "is-failed", "list-units", "list-unit-files", "list-timers", "list-sockets", "show", "cat"] },
    "docker": { "subcommands": ["ps", "images", "logs", "inspect", "version", "info", "stats", "top", "port"] },
    "nginx": { "requiredArguments": ["-t", "-T"] }
  }
}
